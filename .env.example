# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=template          # template | anthropic
LLM_MODEL=                     # model id from your provider; empty = llm.default_model in config/assumptions.yaml
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=2000     # includes the model's thinking tokens on current Claude models
LLM_EFFORT=low                 # low | medium | high
# LLM_TEMPERATURE=             # leave unset: current Claude models reject non-default sampling parameters
# LLM_PRICE_INPUT_PER_MTOK=    # optional, only used to log a cost estimate
# LLM_PRICE_OUTPUT_PER_MTOK=
GREENHOME_FACTOR_SET=DESNZ_2026
GREENHOME_PRICE_SET=OFGEM_2026Q4
GREENHOME_SEED=42
GREENHOME_MEMORY=1             # 0 disables the optional customer memory
